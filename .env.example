# Copy to .env on the server or local machine and replace placeholder values.

POSTGRES_DB=mlr
POSTGRES_USER=mlr
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public port exposed by the frontend/proxy container in docker-compose.prod.yml.
WEB_PORT=8080

# Keep admin disabled for public demo deployments unless actively ingesting.
MLR_ADMIN_ENABLED=false
MLR_ADMIN_TOKEN=replace-with-a-long-random-token

# Use stub for public demos unless provider keys/rate limits are configured.
TRANSLATE_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_LITERARY_MODEL=gpt-4o-mini
OPENAI_MAX_COMPLETION_TOKENS=300
OPENAI_LITERARY_MAX_COMPLETION_TOKENS=700
OPENAI_TIMEOUT_SECONDS=30
GOOGLE_API_KEY=
GOOGLE_LITERARY_MODEL=gemini-2.5-flash
GOOGLE_MAX_OUTPUT_TOKENS=512
GOOGLE_LITERARY_MAX_OUTPUT_TOKENS=1024

# Container timezone used for daily quota resets.
TZ=UTC

# Applied to non-stub providers. Limits reset at midnight in TZ.
TRANSLATE_LIMITS_ENABLED=true
TRANSLATE_LIMITS_PER_IP_DAILY=10
TRANSLATE_LIMITS_GLOBAL_DAILY=100
TRANSLATE_LIMITS_MAX_TEXT_CHARS=800
TRANSLATE_LIMITS_LITERARY_PER_IP_DAILY=5
TRANSLATE_LIMITS_LITERARY_GLOBAL_DAILY=50
TRANSLATE_LIMITS_LITERARY_MAX_TEXT_CHARS=2000

# Keep only health/info public by default. Use "health,info,prometheus" only for
# private/local observability and do not expose actuator endpoints publicly.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# Host directories mounted into the production ingest-runner.
# Put Kaikki/Wiktextract JSONL files here, for example
# ./dictionaries/kaikki.org-dictionary-German.jsonl.gz.
# Put local book files/manifests under ./ops/ingestion for server-side runner uploads.
DICTIONARY_DIR=./dictionaries
INGESTION_MANIFEST_DIR=./ops/ingestion
