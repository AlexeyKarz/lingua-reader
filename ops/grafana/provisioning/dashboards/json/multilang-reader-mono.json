{
  "id": null,
  "uid": "mlr-mono",
  "title": "Multilang Reader — Monolith",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate by endpoint (RPS)",
      "targets": [
        {
          "expr": "sum by (method, uri)(rate(http_server_requests_seconds_count{uri!=\"/actuator/prometheus\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by endpoint (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{uri!=\"/actuator/prometheus\"}[5m])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Translate calls by provider/op (RPS)",
      "targets": [
        {
          "expr": "sum by (provider, operation, outcome) (rate(translate_provider_calls_total[1m]))",
          "legendFormat": "{{provider}} {{operation}} {{outcome}}"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Translate p95 latency (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider, operation) (rate(translate_provider_latency_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} {{operation}}"
        }
      ],
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Translate endpoint vs provider p95 ratio",
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api/translate/(word|sentence)\"}[5m]))) * on() group_left(provider) max by (provider) (translate_provider_calls_total{operation=\"literal\"})) / histogram_quantile(0.95, sum by (le, provider) (rate(translate_provider_latency_seconds_bucket{operation=\"literal\"}[5m])))",
          "legendFormat": "{{provider}} literal"
        },
        {
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/translate/explain\"}[5m]))) * on() group_left(provider) max by (provider) (translate_provider_calls_total{operation=\"explain\"})) / histogram_quantile(0.95, sum by (le, provider) (rate(translate_provider_latency_seconds_bucket{operation=\"explain\"}[5m])))",
          "legendFormat": "{{provider}} explain"
        }
      ],
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Reader page requests (RPS)",
      "targets": [
        {
          "expr": "sum by (method, src, tgt, outcome) (rate(reader_page_requests_total[1m]))",
          "legendFormat": "{{method}} {{src}}->{{tgt}} {{outcome}}"
        }
      ],
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Reader p95 latency (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method, src, tgt) (rate(reader_page_fetch_seconds_bucket[5m])))",
          "legendFormat": "{{method}} {{src}}->{{tgt}}"
        }
      ],
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Reader fallback to any method (RPS)",
      "targets": [
        {
          "expr": "sum by (method, src, tgt) (rate(reader_page_fallback_total[5m]))",
          "legendFormat": "{{method}} {{src}}->{{tgt}}"
        }
      ],
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Translate error rate %",
      "targets": [
        {
          "expr": "100 * sum(rate(translate_provider_calls_total{outcome=\"fail\"}[5m])) / sum(rate(translate_provider_calls_total[5m]))"
        }
      ],
      "gridPos": { "x": 0, "y": 34, "w": 6, "h": 6 },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "colorMode": "value" }
    },
    {
      "type": "stat",
      "title": "HTTP 5xx rate %",
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))"
        }
      ],
      "gridPos": { "x": 6, "y": 34, "w": 6, "h": 6 },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "colorMode": "value" }
    },
    {
      "type": "timeseries",
      "title": "JVM heap used vs max (bytes)",
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "heap max" }
      ],
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Process CPU usage %",
      "targets": [
        { "expr": "avg(process_cpu_usage) * 100", "legendFormat": "process" }
      ],
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Uptime (h)",
      "targets": [
        { "expr": "process_uptime_seconds / 3600" }
      ],
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 6 }
    }
  ]
}
