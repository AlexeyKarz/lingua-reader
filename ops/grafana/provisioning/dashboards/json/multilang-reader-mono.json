{
  "id": null,
  "uid": "mlr-mono",
  "title": "Multilang Reader — Monolith",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate by endpoint (RPS)",
      "targets": [
        {
          "expr": "sum by (method, uri)(rate(http_server_requests_seconds_count{uri!=\"/actuator/prometheus\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by endpoint (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{uri!=\"/actuator/prometheus\"}[5m])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "stat",
      "title": "Error rate % (5xx)",
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "colorMode": "value" }
    },
    {
      "type": "timeseries",
      "title": "JVM heap used vs max (bytes)",
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "heap max" }
      ],
      "gridPos": { "x": 8, "y": 16, "w": 16, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Process CPU usage %",
      "targets": [
        { "expr": "avg(process_cpu_usage) * 100", "legendFormat": "process" }
      ],
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Uptime (h)",
      "targets": [
        { "expr": "process_uptime_seconds / 3600" }
      ],
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 6 }
    }
  ]
}
